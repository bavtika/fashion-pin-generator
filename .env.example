# ── Required ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id_as_integer

# ── Optional: Dolphin Anty (anti-detect browser for Pinterest scraping) ───
# If set, scraper attaches to Dolphin instead of launching bare Chromium.
DOLPHIN_PROFILE_ID=
# DOLPHIN_API_TOKEN=
# DOLPHIN_API=http://host.docker.internal:3001/v1.0

# ── Optional: Gemini timeouts (seconds) ───────────────────────────────────
# GEMINI_IMAGE_STEP_TIMEOUT=75
# GEMINI_DESCRIBE_STEP_TIMEOUT=90
# GEMINI_REQUEST_TIMEOUT=90
# GEMINI_WATCHDOG_TIMEOUT=75
# GEMINI_IMAGE_MAX_ATTEMPTS=2
# GEMINI_RECOVERY_TIMEOUT=25
# GEMINI_BROWSER_DESCRIBE_ENABLED=1
# GEMINI_BROWSER_DESCRIBE_TIMEOUT=75
# GEMINI_MAX_DESCRIPTION_CHARS=1200
# GEMINI_STYLE_MAX_PX=1280

# ── Optional: logging ─────────────────────────────────────────────────────
# LOG_LEVEL=INFO
